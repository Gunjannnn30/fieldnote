# Fieldnote configuration. Copy to .env and edit.
# Every value can also be set as an environment variable: FIELDNOTE_<NAME>

# --- models -------------------------------------------------------------
# FIELDNOTE_TEXT_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FIELDNOTE_IMAGE_MODEL=openai/clip-vit-base-patch32
# FIELDNOTE_CLAP_MODEL=laion/clap-htsat-unfused
# FIELDNOTE_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# FIELDNOTE_CAPTION_MODEL=Salesforce/blip-image-captioning-base
# FIELDNOTE_WHISPER_MODEL=openai/whisper-tiny.en
# FIELDNOTE_VLM_MODEL=HuggingFaceTB/SmolVLM-500M-Instruct

# --- storage ------------------------------------------------------------
# sqlite (default, no infrastructure) | pgvector | qdrant
# FIELDNOTE_STORE_BACKEND=sqlite
# FIELDNAME_PG_DSN=postgresql://postgres:postgres@localhost:5432/fieldnote
# FIELDNOTE_QDRANT_URL=http://localhost:6333

# --- retrieval ----------------------------------------------------------
# FIELDNOTE_CANDIDATE_K=40
# FIELDNOTE_FINAL_K=20
# FIELDNOTE_FUSION=rrf
# FIELDNOTE_RRF_K=60

# --- synthesis ----------------------------------------------------------
# extractive (default, CPU friendly) | vlm
# FIELDNOTE_SYNTHESIS=extractive

# --- runtime ------------------------------------------------------------
# FIELDNOTE_DEVICE=cpu
# FIELDNOTE_TORCH_THREADS=4
# FIELDNOTE_OCR_ENABLED=true
